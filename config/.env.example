# Copiar a .env (ignorado por git). Sin estas variables el pipeline usa Cassandra local en 127.0.0.1:9042.
# Cassandra local (infra/docker-compose.yml)
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
# AstraDB: si están definidas las dos, el pipeline escribe en AstraDB (D-11)
# ASTRA_DB_SECURE_BUNDLE_PATH=./secure-connect-cpa.zip
# ASTRA_DB_TOKEN=AstraCS:xxxxxxxx
# ASTRA_DB_KEYSPACE=cpa
